{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipSync",
  "version": "0.1.0",
  "identifier": "com.clipsync.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "ClipSync",
      "width": 1120,
      "height": 760,
      "minWidth": 380,
      "minHeight": 440,
      "dragDropEnabled": true
    }],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGQkQ4ODg3NDQwRDlCNTAKUldSUW13MUVoNGk5bnhKMXFtazl6bzhzblJ4OW1yOUhQczR6a1l0QUVSbmxxZE1sOVdrek9vQW8K",
      "endpoints": [
        "https://github.com/kai3316/clipsync/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    },
    "icon": [
      "../../assets/32x32.png",
      "../../assets/128x128.png",
      "../../assets/128x128@2x.png",
      "../../assets/icon.png",
      "../../assets/icon.ico",
      "../../assets/icon.icns"
    ]
  }
}
