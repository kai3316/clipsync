# Bytecode
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
venv/
.venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build / packaging
dist/
build/
*.egg-info/

# Frontend tooling (vitest/npm dev dependencies — not shipped)
node_modules/

# Logs
*.log
*.log.[123]

# Config (contains private keys!)
config.json
*.pem

# Test
.pytest_cache/
htmlcov/
.coverage

# Environment
.env
.claude/

# Per-run /kai round handoff (context compression)
.kai-round.md

# Tauri generated/build files
desktop/src-tauri/target/
desktop/src-tauri/gen/
desktop/src-tauri/binaries/*
!desktop/src-tauri/binaries/.gitkeep
# The macOS sidecar is a directory build staged here for the bundler; see
# clipsync-sidecar.spec for why that platform stages a tree.
desktop/src-tauri/sidecar/
.tauri-dev-data/
desktop/test-results/
desktop/playwright-report/
# Playwright's own bookkeeping, in whichever directory a run was started from.
test-results/
playwright-report/

# Per-run migration probes, patch scripts and scratch CSS (not shipped)
work/

# Working notes: the migration record, the parity audits, the contract tables
# and the redesign plan.  Kept on the maintainer's disk and deliberately not
# published -- `docs/` is the GitHub Pages root, so anything under it is served,
# and these belong to the process rather than to the product.
notes/
